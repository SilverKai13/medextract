# Copy to .env and adjust. All settings are also settable as environment
# variables with the same names.

# Where the served model lives. Point at artifacts/onnx for the exported graph
# or artifacts/run/model to serve PyTorch directly.
MEDEXTRACT_MODEL_DIR=artifacts/onnx
MEDEXTRACT_BACKEND=onnx
MEDEXTRACT_MODEL_VERSION=dev

# Request limits.
MEDEXTRACT_MAX_INPUT_CHARS=20000
MEDEXTRACT_MAX_SEQUENCE_LENGTH=256
MEDEXTRACT_STRIDE=32

# Retrieval.
MEDEXTRACT_RETRIEVAL_ENABLED=true
MEDEXTRACT_QDRANT_URL=http://localhost:6333
MEDEXTRACT_QDRANT_COLLECTION=pubmed_abstracts
MEDEXTRACT_EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
MEDEXTRACT_EMBEDDING_ONNX_DIR=artifacts/embedder

MEDEXTRACT_LOG_LEVEL=INFO

# NCBI asks for a contact address on E-utilities traffic. An API key raises the
# rate limit from 3 to 10 requests a second; neither is required at this volume.
MEDEXTRACT_NCBI_EMAIL=
MEDEXTRACT_NCBI_API_KEY=
